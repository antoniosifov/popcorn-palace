# Copy to .env to override the host ports used by docker compose.
# Useful when one of them is already taken on your machine.
# The web client: what you open in the browser.
WEB_PORT=3000
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8080
# Kafka, as seen from programs running on the host (not from other containers).
KAFKA_PORT=29092
# Mailpit: the web page that shows sent emails, and the SMTP port it listens on.
MAILPIT_PORT=8025
SMTP_PORT=1025
# Grafana (dashboard), Jaeger (traces) and Prometheus (metrics).
GRAFANA_PORT=3001
JAEGER_PORT=16686
PROMETHEUS_PORT=9090

# Password of the Grafana "admin" account (viewing the dashboard needs no login).
GRAFANA_PASSWORD=admin

# Log layout of both services: empty for the readable one, "ecs" for one JSON
# object per line (what log collectors expect).
LOG_FORMAT=

# The time zone of the cinema (an IANA name such as Europe/Berlin). Showtimes
# are shown and entered on its clock, and the demo programme is scheduled by it.
CINEMA_TIME_ZONE=UTC

# A programme for an empty installation: halls, movies and a week of showtimes,
# topped up every day. Set to false to start with an empty catalog.
DEMO_DATA=true

# Films in cinemas now, with posters, descriptions and trailers, from TMDB
# (https://www.themoviedb.org). Create a free account there, ask for an API key
# in its settings and paste the "API Read Access Token" here. Empty: a small
# built-in catalog is used and the client draws title cards instead of posters.
TMDB_API_KEY=
# Cinemas of which country (ISO 3166-1), and titles in which language.
TMDB_REGION=US
TMDB_LANGUAGE=en-US

# Signing in with Google. In the Google Cloud console create an "OAuth client ID"
# of type "Web application", with the authorised redirect URI
# http://localhost:3000/api/auth/google/callback (your site's address in place
# of localhost:3000), and paste its id and secret here. Both empty: the
# "Continue with Google" button is not offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login and registration attempts allowed per visitor per minute.
AUTH_RATE_LIMIT=10

# Administrator account created at startup if it does not exist yet.
# The values below are the development defaults used by docker compose.
ADMIN_EMAIL=admin@popcorn.local
ADMIN_PASSWORD=admin-dev-password

# Key that signs access tokens (at least 32 characters). When empty, a random
# key is generated at each start and existing tokens stop working after a restart.
JWT_SECRET=
