# The .env of a server. deploy/bootstrap.sh copies this file to .env in the
# repository root and fills in the secrets it can make up itself; the rest is
# filled in by hand. The file stays on the server and is never committed.

# Plain `docker compose` on the server means the stack with its production layer.
COMPOSE_FILE=compose.yml:compose.prod.yml

# The four names the stack is served under. Each needs a DNS record that points
# at the server (one wildcard record for *.popcorn.example.com covers three).
SITE_HOST=popcorn.example.com
API_HOST=api.popcorn.example.com
GRAFANA_HOST=grafana.popcorn.example.com
TRACES_HOST=traces.popcorn.example.com

# Made up by deploy/bootstrap.sh. Nothing outside the server needs to know them,
# except whoever logs in as the administrator of the cinema or of Grafana.
DB_PASSWORD=
JWT_SECRET=
ADMIN_PASSWORD=
GRAFANA_PASSWORD=

# The administrator of the cinema logs in with this address.
ADMIN_EMAIL=

# The mail service that delivers tickets, spoken to over SMTP with STARTTLS.
# The values below are those of Resend (https://resend.com): the user name is
# the word "resend", the password is an API key, and the sender's domain has to
# be verified there first.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM="Popcorn Palace <tickets@mail.example.com>"

# Films in cinemas now, from TMDB (see .env.example in the repository root).
TMDB_API_KEY=
TMDB_REGION=US
TMDB_LANGUAGE=en-US

# The clock of the cinema: showtimes on the site and in emails.
CINEMA_TIME_ZONE=UTC

# One JSON object per log line.
LOG_FORMAT=ecs
